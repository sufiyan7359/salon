# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# Database (native Homebrew postgresql@17 - see README for setup)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=salon_user
DB_PASSWORD=salon_pass
DB_NAME=salon_db

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# OTP
# OTP_PROVIDER=stub   -> codes are logged to console, no SMS sent (default, safe with no Twilio account)
# OTP_PROVIDER=twilio -> sends real SMS via Twilio; requires the TWILIO_* vars below.
#                        If they're missing/incomplete, falls back to stub automatically with a warning log.
OTP_PROVIDER=stub
OTP_EXPIRES_IN_MINUTES=5
OTP_LENGTH=6

# Twilio (only used when OTP_PROVIDER=twilio)
# Get these from https://console.twilio.com after creating a trial account:
#   TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN -> Account dashboard
#   TWILIO_FROM_NUMBER -> the trial phone number Twilio assigns you (E.164 format, e.g. +15551234567)
# Note: trial accounts can only send SMS to phone numbers you've verified in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
