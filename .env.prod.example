# Copy to .env at the repo root before running:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build

# Public URL of the frontend, used for the backend's CORS allow-list.
# (In this reverse-proxy setup the frontend calls the API same-origin via
# nginx, so this is mostly a safety net for any cross-origin access.)
CORS_ORIGIN=https://your-domain.example

# Port nginx (the frontend container) listens on, mapped to the host.
HTTP_PORT=80

# Database
DB_USERNAME=salon_user
DB_PASSWORD=change-me-to-a-strong-password
DB_NAME=salon_db

# JWT - generate real random secrets for production, e.g.:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# OTP - switch to a real provider (Twilio/MSG91) before going live;
# "stub" only logs codes server-side and never sends an SMS.
OTP_PROVIDER=stub
OTP_EXPIRES_IN_MINUTES=5
OTP_LENGTH=6
